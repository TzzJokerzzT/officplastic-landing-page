{
	"name": "officplatic-langing-page",
	"type": "module",
	"packageManager": "pnpm@12.4.1",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro check && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "astro check",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/react": "^7.0.0",
		"@iconify-json/mdi": "^1.2.3",
		"@iconmind/react": "^0.8.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"astro": "^7.3.5",
		"astro-icon": "^1.2.0",
		"motion": "^13.4.4",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwind-animations": "^1.0.2",
		"tailwindcss": "^4.3.3"
	},
	"allowScripts": {
		"esbuild": true
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "2.5.14",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/sora": "^5.3.0",
		"@vitest/coverage-v8": "^5.0.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.2"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mjs,cjs,astro,json,md,yml,yaml}": "biome check --write"
	}
}
