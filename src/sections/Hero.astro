---
import { Icon } from "astro-icon/components";
import Button from "../components/ui/Button.astro";
import Reveal from "../components/ui/Reveal.astro";
import { ctaHref, site } from "../data/site";
---

<section id="inicio" class="flex flex-col items-center px-6 pb-16 pt-14 sm:pt-20">
	<Reveal as="div" timeline={false} animation="animate-fade-in-up" delay="animate-delay-0" class="inline-flex items-center gap-2 rounded-full bg-brand/10 px-4 py-1.5 text-xs font-semibold text-brand sm:text-sm">
		<span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
		{site.hero.eyebrow}
	</Reveal>

	<Reveal animation="animate-fade-in-up" delay="animate-delay-100" class="mt-6 max-w-4xl text-center">
		<h1 class="font-display text-4xl font-extrabold leading-tight text-ink sm:text-6xl">
			{site.hero.titleLine1}
			<br />
			{site.hero.titleLine2}
		</h1>
	</Reveal>

	<Reveal animation="animate-fade-in-up" delay="animate-delay-200" class="mt-5 max-w-2xl text-center">
		<p class="text-base text-muted sm:text-lg">
			{site.hero.subtitle}
		</p>
	</Reveal>

	<Reveal as="div" timeline={false} animation="animate-fade-in-up" delay="animate-delay-300" class="mt-8 flex flex-col gap-3 sm:flex-row">
		<Button href={ctaHref(site.hero.primaryCta)} variant="primary" size="lg">
			{site.hero.primaryCta.label}
			<Icon name="mdi:arrow-right" size={20} />
		</Button>
		<Button href={ctaHref(site.hero.secondaryCta)} variant="whatsapp" size="lg">
			<Icon name="mdi:whatsapp" size={20} />
			{site.hero.secondaryCta.label}
		</Button>
	</Reveal>

	<Reveal timeline={false} animation="animate-slide-in-bottom" delay="animate-delay-300" class="mt-12 grid w-full max-w-4xl grid-cols-1 gap-4 sm:grid-cols-3">
		{
			site.hero.showcase.items.map((item) => (
				<div class="flex items-center gap-4 rounded-2xl bg-surface p-5">
					<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand">
						<Icon name={item.icon} size={26} />
					</span>
					<p class="font-semibold text-ink">{item.title}</p>
				</div>
			))
		}
	</Reveal>

	<Reveal timeline={false} animation="animate-fade-in" delay="animate-delay-500" class="mt-12 grid w-full max-w-4xl grid-cols-2 gap-6 border-t border-line pt-8 sm:grid-cols-4">
		{
			site.hero.stats.map((stat) => (
				<div class="text-center">
					<dt class="order-2 mt-1 text-xs text-muted sm:text-sm">{stat.label}</dt>
					<dd class="order-1 font-display text-3xl font-bold text-ink sm:text-4xl">{stat.value}</dd>
				</div>
			))
		}
	</Reveal>
</section>
